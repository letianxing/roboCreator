import FreeCAD as App
import FreeCADGui as Gui
from PySide import QtCore
doc=App.openDocument(r'G:\Golands\roboCreator\09_cad\ankle_v07_axial\wukong_ankle_v07.FCStd')
for obj in doc.Objects:
    if hasattr(obj,'Shape'):
        obj.ViewObject.Visibility=True
doc.RollMotor_VendorSurface.ViewObject.ShapeColor=(0.18,0.23,0.3)
doc.PitchMotor_VendorSurface.ViewObject.ShapeColor=(0.18,0.23,0.3)
doc.FootPlate_Concept.ViewObject.ShapeColor=(0.3,0.4,0.5)
doc.Shank_ClearanceProxy.ViewObject.ShapeColor=(0.55,0.6,0.65)
doc.Roll_ClosedEnvelope.ViewObject.Visibility=False
doc.Pitch_ClosedEnvelope.ViewObject.Visibility=False
doc.RollAxis_Schematic.ViewObject.ShapeColor=(1.,0.1,0.1)
doc.PitchAxis_Schematic.ViewObject.ShapeColor=(0.1,0.8,0.2)
doc.RequiredYoke_Schematic.ViewObject.LineColor=(1.,0.5,0.)
doc.RequiredYoke_Schematic.ViewObject.LineWidth=3
Gui.activeDocument().activeView().viewAxonometric()
Gui.activeDocument().activeView().fitAll()
doc.recompute()
doc.save()
def capture_ankle_axial():
    Gui.updateGui()
    Gui.activeDocument().activeView().viewAxonometric()
    Gui.activeDocument().activeView().fitAll()
    Gui.updateGui()
    doc.save()
    Gui.activeDocument().activeView().saveImage(r'G:\Golands\roboCreator\09_cad\ankle_v07_axial\preview.png',1200,1000,'White')
QtCore.QTimer.singleShot(5000,capture_ankle_axial)
